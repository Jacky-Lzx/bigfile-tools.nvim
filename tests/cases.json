{
  "version": 1,
  "default": [
    "unit"
  ],
  "defaults": {},
  "cases": [
    {
      "name": "docs",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/docs_checks.py",
        "--nvim",
        "{nvim}"
      ],
      "files": [
        "tests/docs_checks.py"
      ],
      "timeout": 60
    },
    {
      "name": "runner-contracts",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/runner_checks.py"
      ],
      "files": [
        "tests/runner_checks.py"
      ],
      "timeout": 120
    },
    {
      "name": "core",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--headless",
        "-u",
        "NONE",
        "-i",
        "NONE",
        "--noplugin",
        "-n",
        "-l",
        "tests/core.lua"
      ],
      "files": [
        "tests/core.lua"
      ],
      "timeout": 90
    }
  ],
  "support": {
    "tests/run.sh": "Stable shell entry point for tests/run.py"
  },
  "manual": {}
}
